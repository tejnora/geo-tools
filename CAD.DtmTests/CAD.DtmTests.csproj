    <ProjectReference Include="..\CAD\CAD.csproj" />
    <Content Include="..\CAD\DTM\Doc\Samples\*.xml" Link="Samples\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
