<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>AvalonDock</RootNamespace>
    <AssemblyName>AvalonDock</AssemblyName>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>AvalonDock.snk</AssemblyOriginatorKeyFile>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="DrWPF\ConceptualPanel.cs;DrWPF\DisconnectedUIElementCollection.cs;DrWPF\LogicalPanel.cs" />
    <Page Remove="Themes\Classic2.xaml" />
    <Resource Include="Resources\images\**\*.png" />
  </ItemGroup>

</Project>
