<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>CAD</RootNamespace>
    <AssemblyName>CAD</AssemblyName>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <ApplicationManifest>Properties\app.manifest</ApplicationManifest>
    <ApplicationVersion>1.2.1.*</ApplicationVersion>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="TestFiles\SigningVerification\**\*.cs" />
    <Compile Remove="Resources\XmlLanguageDictionary.cs;Utils\BigInteger.cs;Utils\MenuItemCollection.cs;VFK\VFKRegisterIFace.cs;VFK\VFKSimpleActivePoint.cs;VFK\VFKSimpleLine.cs;VFK\VFKSimpleMark.cs" />
    <Resource Include="Icons\*.png" />
    <Resource Include="GUI\*.png" />
    <Resource Include="Localization\cs-CZ.xml" CopyToOutputDirectory="Always" />
    <EmbeddedResource Include="Resources\hmove.cur" />
    <Content Include="DTM\Doc\xsd\**\*.xsd" CopyToOutputDirectory="PreserveNewest" />
    <EmbeddedResource Include="DTM\Configuration\DtmSchema.json;DTM\Configuration\DtmAliases.json" />
    <Content Include="DTM\Configuration\DtmConfiguration.json" Link="Data\DtmConfiguration.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="DTM\Symbols\*.png" Link="Data\DtmSymbols\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AvalonDock\AvalonDock\AvalonDock.csproj" />
    <ProjectReference Include="..\DxfLibrary\DxfLibrary.csproj" />
    <ProjectReference Include="..\GeoBase\GeoBase.csproj" />
  </ItemGroup>

  <Target Name="CopyLocalization" AfterTargets="Build">
    <ItemGroup>
      <LocalizationFiles Include="$(ProjectDir)Localization\*" />
    </ItemGroup>
    <Copy SourceFiles="@(LocalizationFiles)" DestinationFolder="$(OutDir)Languages\" />
  </Target>

</Project>
