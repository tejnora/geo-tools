<Window x:Class="CAD.DTM.Gui.DtmSigningSettingsDialog" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nastavení podpisu adresáře" Width="660" Height="660" MinWidth="540" MinHeight="480"
        Style="{DynamicResource DialogWindowStyle}" Background="#F7F8FA"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Window.Resources>
        <ResourceDictionary Source="../../Themes/DialogForms.xaml" />
    </Window.Resources>
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom">
            <TextBlock x:Name="_error" Foreground="Firebrick" TextWrapping="Wrap" Margin="0,8" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Uložit" IsDefault="True" Click="OnSave" />
                <Button Content="Zrušit" IsCancel="True" />
            </StackPanel>
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <TextBlock Text="Podpisový certifikát" FontWeight="SemiBold" />
                <TextBlock x:Name="_certificate" TextWrapping="Wrap" Margin="0,8" />
                <Button Content="Vybrat certifikát…" Click="OnChooseCertificate" HorizontalAlignment="Left" Margin="0,0,0,16" />
                <TextBlock Text="Časové razítko PostSignum" FontWeight="SemiBold" Margin="0,0,0,8" />
                <Label Content="Adresa serveru TSA:" Target="{Binding ElementName=_url}" />
                <TextBox x:Name="_url" />
                <Label Content="Uživatelské jméno:" Target="{Binding ElementName=_userName}" />
                <TextBox x:Name="_userName" />
                <Label Content="Heslo:" Target="{Binding ElementName=_password}" />
                <PasswordBox x:Name="_password" MinHeight="30" Padding="7,4" Margin="0,4" />
                <CheckBox x:Name="_rememberPassword" Content="Zapamatovat heslo pro tohoto uživatele Windows" />
                <TextBlock Text="Certifikát a server časových razítek se použijí pro podpis celého výstupního adresáře včetně podadresářů."
                           TextWrapping="Wrap" Foreground="#596273" Margin="0,12,0,0" />
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
