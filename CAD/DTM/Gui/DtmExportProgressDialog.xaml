<Window x:Class="CAD.DTM.Gui.DtmExportProgressDialog"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Průběh exportu DTM" Width="760" Height="400" MinWidth="540" MinHeight="300"
        Style="{DynamicResource DialogWindowStyle}" Background="#F7F8FA"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        ContentRendered="OnContentRendered" Closing="OnClosing">
    <Window.Resources>
        <ResourceDictionary Source="../../Themes/DialogForms.xaml" />
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock x:Name="_summary" Text="Probíhá export DTM…" FontWeight="SemiBold" Margin="0,0,0,12" TextWrapping="Wrap" />
        <Border Grid.Row="1" Background="White" BorderBrush="#D9DDE3" BorderThickness="1" Padding="12">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="130" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Akce" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="1" Text="Stav" FontWeight="SemiBold" />
                </Grid>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding Actions}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,8" Background="Transparent" ToolTipService.ShowDuration="60000">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="130" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.ToolTip>
                                        <ToolTip MaxHeight="480">
                                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                                <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" MaxWidth="600" />
                                            </ScrollViewer>
                                        </ToolTip>
                                    </Grid.ToolTip>
                                    <TextBlock Text="{Binding Name}" TextWrapping="Wrap" Margin="0,0,16,0" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <TextBlock Text="{Binding Icon}" Foreground="{Binding StatusBrush}" Width="22" FontWeight="Bold" />
                                        <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusBrush}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>
        <Button x:Name="_close" Grid.Row="2" Content="Zavřít" HorizontalAlignment="Right"
                IsEnabled="False" IsCancel="True" Click="OnClose" />
    </Grid>
</Window>
