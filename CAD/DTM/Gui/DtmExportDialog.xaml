<Gui:DialogBase x:Class="CAD.DTM.Gui.DtmExportDialog"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:Gui="clr-namespace:GeoBase.Gui;assembly=GeoBase"
                xmlns:loc="clr-namespace:GeoBase.Localization;assembly=GeoBase"
                LanguageNamespace="FileTransferDialog"
                loc:Translate.Uid="0"
                Title="{loc:Translate FileTransfer}"
                Style="{DynamicResource DialogWindowStyle}" Background="#F7F8FA" WindowStartupLocation="CenterOwner"
                Width="680" MinWidth="540"
                Height="700" MinHeight="500">
    <Gui:DialogBase.Resources>
        <ResourceDictionary Source="../../Themes/DialogForms.xaml" />
    </Gui:DialogBase.Resources>
    <Gui:DialogBase.DialogContent>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="16,16,16,8" VerticalAlignment="Top">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Label Grid.Column="0" Grid.Row="0" loc:Translate.Uid="DtmExportDirectory" Content="{loc:Translate Výstupní adresář:}"/>
            <TextBox Grid.Row="0" Grid.Column="1" HorizontalAlignment="Stretch" MinWidth="100" Text="{Binding Path=OutputDirectory, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, NotifyOnValidationError=True}" />
            <Button Style="{StaticResource DialogBrowseButtonStyle}" Grid.Row="0" Grid.Column="2" Click="OnDirectoryChooser" Content="..." />
            <Label Grid.Column="0" Grid.Row="1" loc:Translate.Uid="DtmExportUid" Content="{loc:Translate UID_SUBJEKTU:}"/>
            <TextBox Grid.Column="1" Grid.Row="1" Text="{Binding UidSubjektu, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"/>
            <Label Grid.Column="0" Grid.Row="2" loc:Translate.Uid="DtmExportRegion" Content="{loc:Translate PREFIX_KRAJE:}"/>
            <ComboBox Grid.Column="1" Grid.Row="2" ItemsSource="{Binding Regions}" DisplayMemberPath="Value" SelectedValuePath="Key" IsEditable="False" SelectedValue="{Binding PrefixKraje, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=(Validation.Errors)[0].ErrorContent}"/>
            <Label Grid.Column="0" Grid.Row="3" loc:Translate.Uid="DtmExportCgad" Content="{loc:Translate CGAD:}"/>
            <TextBox Grid.Column="1" Grid.Row="3" Text="{Binding Cgad, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"/>
            <Label Grid.Column="0" Grid.Row="4" loc:Translate.Uid="DtmExportFileName" Content="{loc:Translate Název souboru:}"/>
            <Label Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="4" Margin="0,4" HorizontalContentAlignment="Stretch">
                <TextBlock Text="{Binding GeneratedFileName, Mode=OneWay}" TextWrapping="Wrap"/>
            </Label>
            <Label Grid.Column="0" Grid.Row="5" loc:Translate.Uid="148" Content="{loc:Translate Nazev zakazky:}"/>
            <TextBox Grid.Column="1" Grid.Row="5" Text="{Binding Path=NazevZakazky}"/>
            <Label Grid.Column="0" Grid.Row="6" loc:Translate.Uid="150" Content="{loc:Translate Zpracovatel:}"/>
            <TextBox Grid.Column="1" Grid.Row="6" Text="{Binding Path=Zpracovatel}"/>
            <Label Grid.Column="0" Grid.Row="7" loc:Translate.Uid="151" Content="{loc:Translate Organizace zpracovatele:}"/>
            <TextBox Grid.Column="1" Grid.Row="7" Text="{Binding Path=OrganizaceZpracovatele}"/>
            <Label Grid.Column="0" Grid.Row="8" loc:Translate.Uid="152" Content="{loc:Translate Datum mereni:}"/>
            <DatePicker Grid.Column="1" Grid.Row="8" SelectedDate="{Binding Path=DatumMereni}" DisplayDate="2019-01-01"/>
            <Label Grid.Column="0" Grid.Row="9" loc:Translate.Uid="153" Content="{loc:Translate Datum zpracovani:}"/>
            <DatePicker Grid.Column="1" Grid.Row="9" SelectedDate="{Binding Path=DatumZpracovani}" DisplayDate="2019-01-01"/>
            <Label Grid.Column="0" Grid.Row="10" loc:Translate.Uid="154" Content="{loc:Translate AZI:}"/>
            <TextBox Grid.Column="1" Grid.Row="10" Text="{Binding Path=AZI}"/>
            <Label Grid.Column="0" Grid.Row="11" loc:Translate.Uid="155" Content="{loc:Translate Datum overeni:}"/>
            <DatePicker Grid.Column="1" Grid.Row="11" SelectedDate="{Binding Path=DatumOvereni}" DisplayDate="2019-01-01"/>
            <Label Grid.Column="0" Grid.Row="12" loc:Translate.Uid="156" Content="{loc:Translate Cislo overeni:}"/>
            <TextBox Grid.Column="1" Grid.Row="12" Text="{Binding Path=CisloOvereni}"/>
            <CheckBox Grid.Column="0" Grid.ColumnSpan="3" Grid.Row="13"
                      IsChecked="{Binding DescriptionInSketch, Mode=TwoWay}"
                      ToolTip="Samostatný soubor PP.pdf se nevyžaduje, pokud je popisové pole součástí správně pojmenovaného měřického náčrtu MN.pdf.">
                <TextBlock Text="Popisové pole je součástí měřického náčrtu" TextWrapping="Wrap"/>
            </CheckBox>
        </Grid>
        </ScrollViewer>
    </Gui:DialogBase.DialogContent>
    <Gui:DialogBase.CustomButtons>
        <Button loc:Translate.Uid="43" Content="{loc:Translate Ok}" Click="OnExportButtonClick" />
        <Button loc:Translate.Uid="44" Content="{loc:Translate Cancel}" Click="OnCancel" />
    </Gui:DialogBase.CustomButtons>
</Gui:DialogBase>
