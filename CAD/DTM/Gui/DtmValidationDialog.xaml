<gui:DialogBase x:Class="CAD.DTM.Gui.DtmValidationDialog"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:gui="clr-namespace:GeoBase.Gui;assembly=GeoBase"
                xmlns:localization="clr-namespace:GeoBase.Localization;assembly=GeoBase">
    <gui:DialogBase.DialogContent>
        <DockPanel>
            <TextBlock DockPanel.Dock="Top" Margin="4" FontWeight="Bold" Text="{Binding Path=Summary}" />
            <TreeView ItemsSource="{Binding Path=Nodes}" MinHeight="300" MinWidth="600">
                <TreeView.ItemContainerStyle>
                    <Style TargetType="TreeViewItem">
                        <Setter Property="IsExpanded" Value="{Binding Path=IsExpanded, Mode=OneWay}" />
                    </Style>
                </TreeView.ItemContainerStyle>
                <TreeView.ItemTemplate>
                    <HierarchicalDataTemplate ItemsSource="{Binding Path=Children}">
                        <StackPanel Orientation="Horizontal" ToolTipService.ShowDuration="60000" ToolTipService.IsEnabled="{Binding Path=HasToolTip}">
                            <StackPanel.ToolTip>
                                <ToolTip>
                                    <TextBlock Text="{Binding Path=ToolTip}" TextWrapping="Wrap" MaxWidth="520" />
                                </ToolTip>
                            </StackPanel.ToolTip>
                            <TextBlock Text="{Binding Path=Icon}" Foreground="{Binding Path=Brush}" FontWeight="Bold" Width="20" />
                            <TextBlock Text="{Binding Path=Text}" Foreground="{Binding Path=Brush}" />
                        </StackPanel>
                    </HierarchicalDataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>
        </DockPanel>
    </gui:DialogBase.DialogContent>
    <gui:DialogBase.CustomButtons>
        <Button localization:Translate.Uid="161" Content="{localization:Translate Cancel}" Click="OnClose" />
    </gui:DialogBase.CustomButtons>
</gui:DialogBase>
