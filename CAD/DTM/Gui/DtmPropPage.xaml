<UserControl x:Class="CAD.DTM.Gui.DtmPropPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <TabControl>
        <TabItem>
            <TabItem.Header>
                <TextBlock>Vseobecny</TextBlock>
            </TabItem.Header>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Label Grid.Column="0" Grid.Row="0" Content="Nazev objektu:"/>
                <Label Grid.Column="1" Grid.Row="0" Content="{Binding Path=General.Nazev}"/>
                <Label Grid.Column="0" Grid.Row="1" Content="Type objektu:"/>
                <Label Grid.Column="1" Grid.Row="1" Content="{Binding Path=General.Typ}"/>
                <Label Grid.Column="0" Grid.Row="2" Content="Zapis objektu:"/>
                <Label Grid.Column="1" Grid.Row="2" Content="{Binding Path=General.Zapis}"/>
            </Grid>
        </TabItem>
        <TabItem>
            <TabItem.Header>
                <TextBlock>Spolecne atributy</TextBlock>
            </TabItem.Header>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Label Grid.Column="0" Grid.Row="0" Content="Datum vkladu:"/>
                <Label Grid.Column="1" Grid.Row="0" Content="{Binding Path=SpolecneAtributy.DatumVkladu}"/>
                <Label Grid.Column="0" Grid.Row="1" Content="Datum zmeny:"/>
                <Label Grid.Column="1" Grid.Row="1" Content="{Binding Path=SpolecneAtributy.DatumZmeny}"/>
                <Label Grid.Column="0" Grid.Row="2" Content="ID:"/>
                <Label Grid.Column="1" Grid.Row="2" Content="{Binding Path=SpolecneAtributy.ID}"/>
                <Label Grid.Column="0" Grid.Row="3" Content="ID editor:"/>
                <Label Grid.Column="1" Grid.Row="3" Content="{Binding Path=SpolecneAtributy.IDEditora}"/>
                <Label Grid.Column="0" Grid.Row="4" Content="ID zmeny:"/>
                <Label Grid.Column="1" Grid.Row="4" Content="{Binding Path=SpolecneAtributy.IDZmeny}"/>
                <Label Grid.Column="0" Grid.Row="5" Content="Popis objektu:"/>
                <Label Grid.Column="1" Grid.Row="5" Content="{Binding Path=SpolecneAtributy.PopisObjektu}"/>
                <Label Grid.Column="0" Grid.Row="6" Content="Vklad osoba:"/>
                <Label Grid.Column="1" Grid.Row="6" Content="{Binding Path=SpolecneAtributy.VkladOsoba}"/>
                <Label Grid.Column="0" Grid.Row="7" Content="Zmena osoba:"/>
                <Label Grid.Column="1" Grid.Row="7" Content="{Binding Path=SpolecneAtributy.ZmenaOsoba}"/>
            </Grid>
        </TabItem>
        <TabItem>
            <TabItem.Header>
                <TextBlock>Spolecne atributy ZPS</TextBlock>
            </TabItem.Header>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Label Grid.Column="0" Grid.Row="0" Content="Uroven umisteni:"/>
                <Label Grid.Column="1" Grid.Row="0" Content="{Binding Path=SpolecneAtributyZPS.UrovenUmisteniObjektuZPS}"/>
                <Label Grid.Column="0" Grid.Row="1" Content="Trida presnosti polohy:"/>
                <Label Grid.Column="1" Grid.Row="1" Content="{Binding Path=SpolecneAtributyZPS.TridaPresnostiPoloha}"/>
                <Label Grid.Column="0" Grid.Row="2" Content="Trida presnosti vyska:"/>
                <Label Grid.Column="1" Grid.Row="2" Content="{Binding Path=SpolecneAtributyZPS.TridaPresnostiVyska}"/>
                <Label Grid.Column="0" Grid.Row="3" Content="Zpusob porizeni:"/>
                <Label Grid.Column="1" Grid.Row="3" Content="{Binding Path=SpolecneAtributyZPS.ZpusobPorizeniZPS}"/>
            </Grid>
        </TabItem>
    </TabControl>
</UserControl>
