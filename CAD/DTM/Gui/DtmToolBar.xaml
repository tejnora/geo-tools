<UITools:GeoCadToolBar x:Class="CAD.DTM.Gui.DtmToolBar"
                       xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                       xmlns:UITools="clr-namespace:CAD.UITools"
                       xmlns:gui="clr-namespace:CAD.DTM.Gui">
    <UITools:GeoCadToolBar.CommandBindings>
        <CommandBinding Command="gui:DtmToolBar.DtmArea" CanExecute="OnCanExecute" Executed="OnExecute" />
        <CommandBinding Command="gui:DtmToolBar.DtmMultiLine"
                        CanExecute="OnCanExecute"
                        Executed="OnExecute" />
        <CommandBinding Command="gui:DtmToolBar.DtmPoint"
                        CanExecute="OnCanExecute"
                        Executed="OnExecute" />
        <CommandBinding Command="gui:DtmToolBar.DtmDefinitionPoint"
                        CanExecute="OnCanExecute"
                        Executed="OnExecute" />
    </UITools:GeoCadToolBar.CommandBindings>
    <UITools:GeoCadToolBar.Resources>
        <Style x:Key="CollapsibleGroupItemStyle" TargetType="{x:Type GroupItem}">
            <EventSetter Event="PreviewMouseLeftButtonUp" Handler="OnGroupHeaderMouseUp" />
            <EventSetter Event="PreviewMouseLeftButtonDown" Handler="OnGroupHeaderMouseDown" />
            <EventSetter Event="Loaded" Handler="OnGroupLoaded" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type GroupItem}">
                        <StackPanel>
                            <TextBlock x:Name="GroupHeader" Margin="5,1,1,1" FontWeight="Bold" Background="Transparent"
                                       Text="{Binding Name, StringFormat='▾ {0}'}"/>
                            <ItemsPresenter x:Name="GroupItems" Margin="10,0,0,0" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Tag" Value="Collapsed">
                                <Setter TargetName="GroupItems" Property="Visibility" Value="Collapsed" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UITools:GeoCadToolBar.Resources>
    <Button ToolTip="Enable / Disable layers" Click="OnDtmLayerManager">
        <Image Source="/CAD;component/Icons/VfkLevelManager.png"></Image>
    </Button>

    <ToggleButton x:Name="_validationToggleButton" IsChecked="{Binding IsValidationVisible, Mode=OneWay}" ToolTip="Zobrazit / skrýt panel validace DTM" Click="OnDtmValidate" Content="✔" />
    <ToggleButton Command="gui:DtmToolBar.DtmArea" ToolTip="Plocha: vrcholy z podrobných bodů, H přidá otvor, dokončení jako u linie" Content="▱" />
    <ComboBox Width="140" x:Name="_areaCombo" SelectionChanged="OnElementSelectionChanged" SelectedItem="{Binding DtmAreaElementSelected}" ItemsSource="{Binding DtmAreaElements}">
        <ComboBox.GroupStyle>
            <GroupStyle ContainerStyle="{StaticResource CollapsibleGroupItemStyle}" />
            <GroupStyle ContainerStyle="{StaticResource CollapsibleGroupItemStyle}" />
        </ComboBox.GroupStyle>
        <ComboBox.ItemTemplate><DataTemplate><TextBlock Margin="15,1,1,1" Text="{Binding DisplayName}" /></DataTemplate></ComboBox.ItemTemplate>
    </ComboBox>
    <ToggleButton  Command="gui:DtmToolBar.DtmMultiLine" ToolTip="Line">
        <Image Source="/CAD;component/Icons/VfkLine.png"></Image>
    </ToggleButton>
    <ComboBox Width="120" x:Name="_lineCombo" SelectionChanged="OnElementSelectionChanged"
              SelectedItem="{Binding Path=DtmLineElementSelected}"
              ItemsSource="{Binding Path=DtmLineElements}">
        <ComboBox.GroupStyle>
            <GroupStyle ContainerStyle="{StaticResource CollapsibleGroupItemStyle}" />
            <GroupStyle ContainerStyle="{StaticResource CollapsibleGroupItemStyle}" />
        </ComboBox.GroupStyle>
        <ComboBox.ItemTemplate>
            <DataTemplate>
                <TextBlock Margin="15,1,1,1" Text="{Binding DisplayName}"/>
            </DataTemplate>
        </ComboBox.ItemTemplate>
    </ComboBox>
    <ToggleButton  Command="{Binding CurrentPointCommand}" ToolTip="Point" Name="_pointToggleButton">
        <Image Source="/CAD;component/Icons/VfkMarks.png"></Image>
    </ToggleButton>
    <ComboBox Width="120" x:Name="_pointCombo" SelectionChanged="OnElementSelectionChanged"
              SelectedItem="{Binding Path=DtmPointElementSelected}"
              ItemsSource="{Binding Path=DtmPointElements}">
        <ComboBox.GroupStyle>
            <GroupStyle ContainerStyle="{StaticResource CollapsibleGroupItemStyle}" />
            <GroupStyle ContainerStyle="{StaticResource CollapsibleGroupItemStyle}" />
            <GroupStyle ContainerStyle="{StaticResource CollapsibleGroupItemStyle}" />
        </ComboBox.GroupStyle>
        <ComboBox.ItemTemplate>
            <DataTemplate>
                <TextBlock Margin="25,1,1,1" Text="{Binding DisplayName}"/>
            </DataTemplate>
        </ComboBox.ItemTemplate>
    </ComboBox>

</UITools:GeoCadToolBar>
