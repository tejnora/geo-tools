<gui:DialogBase x:Class="CAD.DTM.Gui.DtmLayerManager"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
                xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
                xmlns:local="clr-namespace:CAD.DTM.Gui"
                xmlns:gui="clr-namespace:GeoBase.Gui;assembly=GeoBase"
                xmlns:localization="clr-namespace:GeoBase.Localization;assembly=GeoBase"
                mc:Ignorable="d" 
                d:DesignHeight="450" d:DesignWidth="400">
    <gui:DialogBase.DialogContent>
        <Grid>
            <TreeView ItemsSource="{Binding Path=Families}">
                <TreeView.Resources>
                    <HierarchicalDataTemplate DataType="{x:Type local:FamilyNode}" ItemsSource="{Binding Members}" >
                        <TextBlock Text="{Binding Path=Name}"/>
                        <!--
                        <CheckBox Content="{Binding Name}" IsChecked="{Binding Path=(local:FamilyNode.IsChecked), Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" >
                            <CheckBox.Style>
                                <Style TargetType="{x:Type CheckBox}">
                                    <Setter Property="Foreground" Value="Black"/>
                                    <Setter Property="Visibility" Value="Visible"/>
                                </Style>
                            </CheckBox.Style>
                        </CheckBox>
                        -->
                    </HierarchicalDataTemplate>
                    <DataTemplate DataType="{x:Type local:LayerNode}" >
                        <CheckBox Content="{Binding Name}" IsChecked="{Binding Path=(local:LayerNode.IsChecked), Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" >
                            <CheckBox.Style>
                                <Style TargetType="{x:Type CheckBox}">
                                    <Setter Property="Foreground" Value="Black"/>
                                    <Setter Property="Visibility" Value="Visible"/>
                                </Style>
                            </CheckBox.Style>
                        </CheckBox>
                    </DataTemplate>
                </TreeView.Resources>
                <TreeView.ItemContainerStyle>
                    <Style TargetType="{x:Type TreeViewItem}">
                        <Setter Property="IsExpanded" Value="True"/>
                    </Style>
                </TreeView.ItemContainerStyle>
            </TreeView>
        </Grid>
    </gui:DialogBase.DialogContent>
    <gui:DialogBase.CustomButtons>
        <Button localization:Translate.Uid="43" Content="{localization:Translate Ok}" Click="OnConfirm" />
        <Button localization:Translate.Uid="44" Content="{localization:Translate Cancel}" Click="OnCancel" />
    </gui:DialogBase.CustomButtons>
</gui:DialogBase>
