<UserControl x:Class="CAD.DTM.Elements.Bod.Gui.DtmPodrobnyBodZPSElementPP"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CAD.DTM.Elements.Bod.Gui"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Label Grid.Column="0" Grid.Row="0" Content="Cislo bodu:"/>
        <TextBox VerticalAlignment="Center" Grid.Column="1" Grid.Row="0" Text="{Binding Path=CisloBodu}" PreviewTextInput="NumberValidationTextBox"/>
    </Grid>
</UserControl>
