<UserControl x:Class="CAD.DTM.Elements.Bod.Gui.DtmZarizeniVodovodniPripojkyBodPP"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Label Grid.Column="0" Grid.Row="0" Content="Typ zařízení vodovodní přípojky:"/>
        <ComboBox Grid.Column="1" Grid.Row="0" SelectedValue="{Binding Path=TypVodovodniPripojky}" SelectedValuePath="Tag">
            <ComboBox.Resources>
                <Style x:Key="ObsoleteItem" TargetType="{x:Type ComboBoxItem}">
                    <Setter Property="Foreground" Value="Red" />
                </Style>
            </ComboBox.Resources>
            <ComboBoxItem Tag="1">šachta vodovodní</ComboBoxItem>
            <ComboBoxItem Style="{StaticResource ObsoleteItem}" Tag="2">šachta měrná a kontrolní</ComboBoxItem>
            <ComboBoxItem Tag="98">jiné</ComboBoxItem>
        </ComboBox>
    </Grid>
</UserControl>
